+def _word_start_times(text, words, timestamps):
+    """Map per-token timestamps to per-word start times (seconds, window-relative).
+
+    Parakeet returns one timestamp per BPE token (often several per word), so
+    words cannot be matched 1:1 to timestamps. Approximate each token's character
+    span by equal share of the text, then a word's start time is the timestamp of
+    the token covering its first character. Returns a list aligned with `words`.
+    """
+    n_tokens = len(timestamps)
+    text_len = len(text)
+    if n_tokens == 0 or text_len == 0:
+        return []
+    starts = []
+    idx = 0
+    for w in words:
+        o = text.find(w, idx)
+        if o < 0:
+            o = idx
+        idx = o + len(w)
+        t = int(o * n_tokens / text_len)
+        if t >= n_tokens:
+            t = n_tokens - 1
+        starts.append(timestamps[t])
+    # guard: word start times must be non-decreasing
+    for i in range(1, len(starts)):
+        if starts[i] < starts[i - 1]:
+            starts[i] = starts[i - 1]
+    return starts
+
+
+
+
+def _tokens_to_words(tokens, timestamps):
+    """Exact token->word map with time spans.
+
+    Parakeet tokens are BPE subwords: a leading space starts a new word,
+    continuation tokens (no leading space) extend it. Each token has a
+    timestamp, so every word gets an exact (start, end) span.
+    tokens: [' The',' qu','ick',' br','o','wn', ...]
+    returns: [(text, start, end), ...]  -- times in seconds
+    """
+    words = []
+    cur = None
+    cur_start = None
+    cur_end = None
+    for tok, t in zip(tokens, timestamps):
+        if tok.startswith(' '):
+            if cur is not None:
+                words.append((cur, cur_start, cur_end))
+            cur = tok.strip()
+            cur_start = t
+            cur_end = t
+        else:
+            cur = (cur or '') + tok
+            cur_end = t
+    if cur is not None:
+        words.append((cur, cur_start, cur_end))
+    return words
+
