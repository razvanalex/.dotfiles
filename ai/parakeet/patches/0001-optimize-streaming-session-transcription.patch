+def _overlap_merge_pair(prev: str, new: str, max_overlap: int = 15) -> str:
+    """Merge prev and new by removing word-level overlap between the TAIL of prev
+    and the HEAD of new. Does not alter internal repetitions inside prev or new."""
+    prev_str = (prev or "").strip()
+    new_str = (new or "").strip()
+    if not prev_str:
+        return new_str
+    if not new_str:
+        return prev_str
+
+    pw = prev_str.split()
+    nw = new_str.split()
+    if not pw or not nw:
+        return f"{prev_str} {new_str}".strip()
+
+    def norm(w):
+        return re.sub(r"[^\w]", "", w).lower()
+
+    norm_pw = [norm(w) for w in pw]
+    norm_nw = [norm(w) for w in nw]
+
+    best = 0
+    max_k = min(len(pw), len(nw), max_overlap)
+    for k in range(max_k, 0, -1):
+        if norm_pw[-k:] == norm_nw[:k]:
+            best = k
+            break
+
+    if best > 0:
+        merged = pw + nw[best:]
+        return " ".join(merged)
+    return f"{prev_str} {new_str}"
+
+
+def _overlap_merge(joined: str) -> str:
+    """Merge "prev new" text by removing the longest word-level overlap
+    between prev's tail and new's head (streaming-ASR seam strategy).
+    "a b c" + "b c d" -> "a b c d". Text-based: robust to the model's
+    per-pass segmentation drift (start times shift 0.1-0.4s)."""
+    words = joined.split()
+    n = len(words)
+    if n < 2:
+        return joined
+    best = (0, 0)  # (overlap_len, seam_index)
+    for seam in range(1, n):
+        left, right = words[:seam], words[seam:]
+        m = 0
+        for o in range(min(len(left), len(right)), 0, -1):
+            if left[-o:] == right[:o]:
+                m = o
+                break
+        if m > best[0]:
+            best = (m, seam)
+    if best[0]:
+        seam = best[1]
+        words = words[:seam] + words[seam + best[0]:]
+    return " ".join(words)
