+@app.route("/v1/audio/stream/<session_id>/chunk", methods=["POST"])
+def stream_chunk(session_id):
+    """Append a raw s16le 16k mono PCM chunk to the session buffer."""
+    with _stream_lock:
+        s = STREAM_SESSIONS.get(session_id)
+        if s is None:
+            return jsonify({"error": "session not found"}), 404
+        data = request.get_data()
+        if not data:
+            return jsonify({"error": "empty chunk"}), 400
+        s["buffer"] += data
+        s["last_chunk_time"] = time.time()
+
+    partial, _ = _transcribe_stream_session(session_id)
+    return jsonify({"ok": True, "partial_text": partial or ""})
+
+
+@app.route("/v1/audio/stream/<session_id>/status", methods=["GET"])
+def stream_status(session_id):
+    with _stream_lock:
+        s = STREAM_SESSIONS.get(session_id)
+        if s is None:
+            return jsonify({"error": "session not found"}), 404
+        s["last_chunk_time"] = time.time()  # status polls keep the session alive
+        # transcribe only when NEW audio arrived since the last pass (bytes
+        # not yet transcribed). The old dirty check (bytes_committed < len)
+        # stayed True forever with trailing non-sentence audio -> the poller
+        # drove full ONNX inference every 0.5s indefinitely while silent.
+        last_done = s.get("last_transcribed_len", 0)
+        dirty = len(s["buffer"]) > last_done
+        due = time.time() - s.get("last_transcribe", 0.0) >= 0.5
+    if dirty and due:
+        _transcribe_stream_session(session_id)
+    with _stream_lock:
+        s2 = STREAM_SESSIONS.get(session_id)
+        if s2 is None:
+            return jsonify({"error": "session not found"}), 404
+        return jsonify({
+            "partial_text": s2["last_partial"],
+            "committed_text": s2["committed_text"],
+            "committed_seconds": s2["bytes_committed"] / (STREAM_SAMPLE_RATE * 2),
+            "buffered_seconds": len(s2["buffer"]) / (STREAM_SAMPLE_RATE * 2),
+        })
+
+@app.route("/v1/audio/stream/<session_id>/flush", methods=["POST"])
+def stream_flush(session_id):
+    """End-of-utterance flush: transcribe the WHOLE buffer (full quality,
+    same as finalize) and make it the committed text.
+
+    The streaming preview's tail (last ~1.5-2s) is provisional by design; at
+    the end of an utterance (VAD silence) there is no next pass to confirm it,
+    so those words would stay uncommitted. Flush closes that gap: the preview
+    becomes full-buffer quality == what finalize/commit will produce.
+    """
+    with _stream_lock:
+        s = STREAM_SESSIONS.get(session_id)
+        if s is None:
+            return jsonify({"error": "session not found"}), 404
+        # NON-BLOCKING acquire: a blocking acquire would hold a waitress worker
+        # thread while waiting for an in-flight transcription, and with few
+        # workers that saturates the queue (seen: "task queue depth 90",
+        # "connection limit reached" -> full deadlock). If busy, tell the
+        # client to retry instead of blocking.
+        if not s["transcribe_lock"].acquire(blocking=False):
+            return jsonify({"error": "session busy, retry"}), 409
+        try:
+            buf = bytes(s["buffer"])
+        except Exception:
+            s["transcribe_lock"].release()
+            raise
+
+    text = ""
+    if len(buf) > 0:
+        try:
+            with _stream_lock:
+                fs = STREAM_SESSIONS.get(session_id)
+                tail_start = max(fs.get("flushed_upto", 0), fs.get("bytes_committed", 0)) if fs else 0
+                committed_so_far = fs.get("committed_text", "") if fs else ""
+            tail = buf[tail_start:]
+            if len(tail) > 0:
+                with _MODEL_LOCK:
+                    import numpy as np
+                    pcm = np.frombuffer(tail, dtype=np.int16).astype(np.float32) / 32768.0
+                    model = get_model("parakeet-tdt-0.6b-v3")
+                    result = model.recognize(pcm, sample_rate=16000)
+                tail_text = result.text.strip() if result and result.text else ""
+                text = _overlap_merge_pair(committed_so_far, tail_text) if committed_so_far else tail_text
+            else:
+                text = committed_so_far
+        except Exception as e:
+            print(f"[stream:{session_id}] flush error: {e}")
+            text = committed_so_far
+
+    try:
+        with _stream_lock:
+            s2 = STREAM_SESSIONS.get(session_id)
+            if s2 is None:
+                return jsonify({"error": "session not found"}), 404
+            s2["committed_text"] = text
+            s2["last_partial"] = text
+            s2["bytes_committed"] = len(buf)
+            s2["word_spans"] = []
+            s2["prev_tail"] = []
+            s2["flushed_upto"] = len(buf)
+        return jsonify({"text": text, "committed_text": text, "partial_text": text})
+    finally:
+        s["transcribe_lock"].release()
+
+
+@app.route("/v1/audio/stream/<session_id>/finalize", methods=["POST"])
+def stream_finalize(session_id):
+    """Final transcription of the full buffer, then delete the session.
+
+    Fast path: if the last /flush already covered the whole buffer (no new
+    audio since the last pause), return its text instead of re-transcribing
+    the entire buffer (which can take ~10s on long dictations)."""
+    with _stream_lock:
+        s = STREAM_SESSIONS.get(session_id)
+        if s is None:
+            return jsonify({"error": "session not found"}), 404
+        buf = bytes(s["buffer"])
+        flushed = s.get("flushed_upto", 0)
+        flushed_text = s.get("committed_text", "")
+        del STREAM_SESSIONS[session_id]
+        print(f"[stream:{session_id[:8]}] FINALIZE deleted (buf {len(buf)}b, flushed {flushed}b)", flush=True)
+
+    if flushed >= len(buf) and flushed_text:
+        return jsonify({"text": flushed_text})
+
+    # Slow path: transcribe uncommitted tail without arbitrary truncation.
+    text = flushed_text
+    tail_start = max(flushed, s.get("bytes_committed", 0))
+    tail = buf[tail_start:]
+    if len(tail) > 0:
+        if _MODEL_LOCK.acquire(timeout=15.0):
+            try:
+                import numpy as np
+                pcm = np.frombuffer(tail, dtype=np.int16).astype(np.float32) / 32768.0
+                model = get_model("parakeet-tdt-0.6b-v3")
+                result = model.recognize(pcm, sample_rate=16000)
+                tail_text = result.text.strip() if result and result.text else ""
+                if tail_text:
+                    if text:
+                        text = _overlap_merge_pair(text, tail_text)
+                    else:
+                        text = tail_text
+            except Exception as e:
+                print(f"[stream:{session_id}] finalize error: {e}")
+            finally:
+                _MODEL_LOCK.release()
+        else:
+            print(f"[stream:{session_id[:8]}] finalize: model busy, using flushed text ({len(text)} chars)", flush=True)
+    return jsonify({"text": text})
+
+
+@app.route("/v1/audio/stream/<session_id>/events")
+def stream_events(session_id):
+    """SSE: push transcript.text.delta events as partial text grows."""
+    def gen():
+        last_text = ""
+        for _ in range(600):  # up to ~60s of idle watching
+            with _stream_lock:
+                s = STREAM_SESSIONS.get(session_id)
+                if s is None:
+                    yield "event: done\ndata: {}\n\n"
+                    return
+                partial = s["last_partial"]
+            if partial != last_text and partial:
+                last_text = partial
+                yield f"event: transcript.text.delta\ndata: {{\"delta\": {json.dumps(partial)}}}\n\n"
+            time.sleep(0.3)
+        yield "event: done\ndata: {}\n\n"
+    return Response(stream_with_context(gen()), mimetype="text/event-stream")
+
