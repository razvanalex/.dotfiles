+def _transcribe_stream_session(sid):
+    """Transcribe the un-committed region for a session; returns (partial, committed_new).
+
+    NVIDIA-style timestamped streaming:
+    - context prefix (1s committed audio) + window (<=15s) transcribed as one
+      continuous input, so the model sees the sentence in progress.
+    - every word carries an absolute time span (token->word map, exact).
+    - COMMIT: whole SENTENCES are locked when they end with .!? AND are
+      settled (END >1.5s behind the buffer end) AND have >=3 words (filler
+      like "Yeah." stays in the tail). A time fallback (25s) forces a
+      sentence-aligned boundary for continuous monologues.
+    - CONTEXT WINS: locked sentences never change; only the provisional tail
+      (incomplete last sentence) may revise.
+    """
+    with _stream_lock:
+        s = STREAM_SESSIONS.get(sid)
+        if s is None:
+            return None, ""
+        if not s["transcribe_lock"].acquire(blocking=False):
+            return s["last_partial"], ""
+        # mark the current buffer length as transcribed-so-far: the /status
+        # poller only re-transcribes when NEW bytes arrive (F9 CPU fix)
+        s["last_transcribed_len"] = len(s["buffer"])
+        try:
+            buf = bytes(s["buffer"])
+            bytes_committed = s["bytes_committed"]
+            s["last_chunk_time"] = time.time()
+        except Exception:
+            s["transcribe_lock"].release()
+            raise
+
+    try:
+        window_bytes = STREAM_WINDOW_S * STREAM_SAMPLE_RATE * 2
+        if bytes_committed >= len(buf):
+            return s["last_partial"], ""
+        # Transcribe from bytes_committed to the end of the buffer so no audio
+        # is ever skipped. With time_expired committing settled words every ~10s,
+        # uncommitted audio naturally stays around 10-12 seconds.
+        window_start = bytes_committed
+        window = buf[window_start:]
+        if len(window) < STREAM_MIN_CHUNK_S * STREAM_SAMPLE_RATE * 2:
+            return s["last_partial"], ""
+
+        # context prefix: up to 1s of committed audio BEFORE the window
+        context_bytes = 1 * STREAM_SAMPLE_RATE * 2
+        ctx_start = max(0, window_start - context_bytes)
+        context = buf[ctx_start:window_start]
+        context_duration = len(context) / (STREAM_SAMPLE_RATE * 2)
+        window_duration = len(window) / (STREAM_SAMPLE_RATE * 2)
+        # absolute time of the window start in the session buffer
+        window_abs_start = window_start / (STREAM_SAMPLE_RATE * 2) - context_duration
+
+        try:
+            with _MODEL_LOCK:
+                model = get_model("parakeet-tdt-0.6b-v3")
+                import numpy as np
+                pcm = np.frombuffer(context + window, dtype=np.int16).astype(np.float32) / 32768.0
+                result = model.recognize(pcm, sample_rate=16000)
+            text = result.text.strip() if result and result.text else ""
+            tokens = list(result.tokens) if result and getattr(result, "tokens", None) else []
+            timestamps = (
+                list(result.timestamps)
+                if result and getattr(result, "timestamps", None) else []
+            )
+        except Exception as e:
+            print(f"[stream:{sid}] transcription error: {e}")
+            return s["last_partial"], ""
+
+        committed_new = ""
+        advance = 0
+        tail_text = text
+
+        if tokens and len(timestamps) == len(tokens):
+            # words with spans, absolute-ized
+            new_words = []
+            for w, ws, we in _tokens_to_words(tokens, timestamps):
+                # strip context words: word starts before the window start.
+                if ws >= context_duration:
+                    new_words.append((w, window_abs_start + ws, window_abs_start + we))
+
+            if new_words:
+                TAIL_MARGIN = 1.5          # settled margin: word END >1.5s behind buffer end
+                MIN_SENTENCE_WORDS = 3     # ignore filler ("Yeah.", "Okay.")
+                buffer_end = len(buf) / (STREAM_SAMPLE_RATE * 2)
+                settled_line = buffer_end - TAIL_MARGIN
+
+                with _stream_lock:
+                    s2 = STREAM_SESSIONS.get(sid)
+                    if s2 is None:
+                        return s["last_partial"], ""
+                    committed_words = []
+                    new_tail = []
+                    # sentence buffer: accumulate words until a sentence ends
+                    sent_words = []        # (word, start, end) in current sentence
+                    sent_start = None
+                    last_boundary_word = None  # index into new_words of last locked end
+
+                    def flush_sentence():
+                        nonlocal sent_words, sent_start
+                        if len(sent_words) >= MIN_SENTENCE_WORDS:
+                            committed_words.extend(sent_words)
+                        else:
+                            # too short ("Yeah.") -> keep as tail; it merges into
+                            # the next real sentence
+                            new_tail.extend(sent_words)
+                        sent_words = []
+                        sent_start = None
+
+                    for w, ws, we in new_words:
+                        if sent_start is None:
+                            sent_start = ws
+                        sent_words.append((w, ws, we))
+                        is_end = w.endswith((".", "!", "?"))
+                        settled = we <= settled_line
+                        # time-based fallback: if speech continues for >10s without
+                        # punctuation, commit settled words so bytes_committed advances
+                        time_expired = (ws - sent_start) > 10.0
+                        short_buf = buffer_end <= TAIL_MARGIN * 2
+                        if (is_end and (settled or short_buf)) or (time_expired and settled):
+                            flush_sentence()
+
+                    # whatever remains is the provisional tail
+                    new_tail.extend(sent_words)
+
+                    committed_new = " ".join(w for w, _, _ in committed_words).strip()
+                    # monotonic committed_text via overlap-merge (no dupes)
+                    if committed_new:
+                        if s2["committed_text"]:
+                            s2["committed_text"] = _overlap_merge_pair(
+                                s2["committed_text"].rstrip(), committed_new)
+                        else:
+                            s2["committed_text"] = committed_new
+                        # advance past the last locked sentence end (even bytes)
+                        if committed_words:
+                            last_end = committed_words[-1][2]
+                            absolute_bytes = int(last_end * STREAM_SAMPLE_RATE * 2)
+                            s2["bytes_committed"] = absolute_bytes - (absolute_bytes % 2)
+                    tail_text = " ".join(w for w, _, _ in new_tail).strip()
+                    partial = (s2["committed_text"] + " " + tail_text).strip()
+                    s2["last_partial"] = partial
+                    s2["last_transcribe"] = time.time()
+                return partial, committed_new
+        # safety: mapping failed -> commit nothing; whole text is the tail
+        with _stream_lock:
+            s2 = STREAM_SESSIONS.get(sid)
+            if s2 is None:
+                return s["last_partial"], ""
+            partial = (s2["committed_text"] + " " + text).strip()
+            s2["last_partial"] = partial
+        return partial, ""
+    finally:
+        s["transcribe_lock"].release()
