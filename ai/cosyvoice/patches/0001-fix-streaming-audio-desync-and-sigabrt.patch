+                if (ctx->is_stop_requested())
+                    return false;
                 if (++overflow_retries > 3)
                 {
                     fprintf(stderr, "[ERROR] LLM generation failed permanently after retries\n");
                     return false;
                 }
-                fprintf(stderr, "[WARN] LLM KV cache overflow — resetting to prompt prefix\n");
+                fprintf(stderr, "[WARN] LLM KV cache overflow \u2014 resetting to prompt prefix\n");
                 ctx->llm_clear_accepted_tokens();
                 ctx->llm_set_kv_cache_len(1 + static_cast<uint32_t>(prompt->prompt_text.size()));
                 ctx->llm_offload_kv_cache();
-                text = nullptr;
                 continue;
             }
         }
