[Unit]
Description=AI subscription usage poller + local REST endpoint (aiusage)
Documentation=file:///home/razvan/.dotfiles/quickshell/.config/quickshell/scripts/aiusage/daemon.py
After=network-online.target

[Service]
Type=simple
# The service owns the settings the quickshell UI used to pass as argv
# (Config.options.aiUsage is now just the client's baseUrl).
Environment=AIUSAGE_HOST=127.0.0.1
Environment=AIUSAGE_PORT=8787
Environment=AIUSAGE_INTERVAL=900
Environment=AIUSAGE_PROVIDERS=antigravity,opencode,copilot,openrouter
# Optional CLIProxyAPI-shaped face (T3's Limits panel): serves
# /v0/management/{auth-files,api-call,reset-quota} from the snapshot, exposing the
# Antigravity groups as codex accounts. Loopback only; holds no token, calls no
# provider, ignores the Authorization header. Unset to make those routes 404.
Environment=AIUSAGE_T3_HUB=1
ExecStart=/usr/bin/python3 /home/razvan/.dotfiles/quickshell/.config/quickshell/scripts/aiusage/daemon.py --serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
